# Copy to .env.local (local) or set in your host's environment settings (production).
# Never commit real values. NEXT_PUBLIC_* values are shipped to the browser - never put a secret there.

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=                     # server-only; also set a monthly spend limit in the Anthropic console
NEXT_PUBLIC_SUPABASE_URL=              # Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # the publishable/anon key (safe for the browser; RLS protects data)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=          # Google Cloud OAuth client (Web); authorized origin = your site URL
NEXT_PUBLIC_SITE_URL=https://example.com   # public origin, no trailing slash: canonical URLs, sitemap, social cards
NEXT_PUBLIC_CONTACT_EMAIL=             # shown on the privacy policy and terms pages

# --- Usage tracking, admin dashboard, guest trial (server-only) -----------
SUPABASE_SERVICE_ROLE_KEY=             # bypasses RLS: server only, never NEXT_PUBLIC_. Needed for tracking + trial quota
ADMIN_EMAILS=you@example.com           # comma-separated; empty = nobody is admin (also exempt from the free quota)
AI_USAGE_LOG_PAYLOADS=true             # false = store metrics only, not prompts/responses
# AI_MODEL_PRICES={"<model id>":{"inputPerMTok":3,"outputPerMTok":15}}

# --- Free quota / guest trial (db/guest-trial.sql must be run first) ------
TRIAL_ENABLED=false                    # true turns on the guest option AND the free quota for signed-in users
TRIAL_DAILY_BUDGET_USD=2               # UTC-day guest spend after which no new guest can start
TRIAL_MAX_ACCOUNTS_PER_IP=3            # new guest accounts per hashed IP per day
TRIAL_IP_SALT=change-me                # any long random string; only a salted hash of the IP is stored
# NEXT_PUBLIC_TRIAL_CAPTCHA=true       # bot check on guest sign-in (needs the two lines below + Supabase secret)
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- Optional model overrides (default: Sonnet 5 for reasoning, Haiku 4.5 for utility) ---
# AI_REASONING_MODEL=claude-sonnet-5
# AI_UTILITY_MODEL=claude-haiku-4-5-20251001
