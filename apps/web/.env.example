# Copy to .env.local (local) or set in your host's environment settings (production).
# Never commit real values. NEXT_PUBLIC_* values are shipped to the browser - never put a secret there.
# Comments are on their own lines on purpose: a bulk paste into a host's env editor would otherwise
# absorb a trailing "# ..." into the value.

# --- Required -------------------------------------------------------------
# Server-only. Also set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=
# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable/anon key (safe for the browser; row-level security protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google Cloud OAuth client (Web); its authorized origin must be your site URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public origin, no trailing slash: canonical URLs, sitemap, social cards. Baked in at build time.
NEXT_PUBLIC_SITE_URL=https://example.com
# Shown on the privacy policy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Usage tracking, admin dashboard, free quota (server-only) ------------
# Bypasses RLS: server only, never NEXT_PUBLIC_. Needed for usage tracking AND the free quota.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated. Empty = nobody is admin. Admins are also exempt from the free quota.
ADMIN_EMAILS=you@example.com
# false = store metrics only, not prompts/responses.
AI_USAGE_LOG_PAYLOADS=true
# AI_MODEL_PRICES={"<model id>":{"inputPerMTok":3,"outputPerMTok":15}}

# --- Free quota / guest trial (db/setup-production.sql must be run first) --
# true turns on the guest option AND the free quota for signed-in users (1 build, 1 Re-simulate, 5 chat).
# false = guests get no access and signed-in users are UNLIMITED (only the Anthropic spend limit protects you).
TRIAL_ENABLED=true
# UTC-day guest spend after which no new guest can start (the guest option then disappears).
TRIAL_DAILY_BUDGET_USD=2
# UTC-day spend by signed-in free accounts after which no new free account can start using the AI.
TRIAL_MEMBER_DAILY_BUDGET_USD=10
# New guest accounts per hashed IP per day.
TRIAL_MAX_ACCOUNTS_PER_IP=3
# REQUIRED in production when the trial is on: any long random string. Only a salted hash of the IP is stored;
# without a salt the trial refuses to run in production.
TRIAL_IP_SALT=
# Bot check on guest sign-in (needs the site key below and the hCaptcha secret in Supabase Auth -> Attack Protection).
# NEXT_PUBLIC_TRIAL_CAPTCHA=true
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- Optional model overrides (default: Sonnet 5 for reasoning, Haiku 4.5 for utility) ---
# AI_REASONING_MODEL=claude-sonnet-5
# AI_UTILITY_MODEL=claude-haiku-4-5-20251001

# --- Debug only. NEVER set in production: prints raw model output and users' text to the logs. ---
# STRUCTURED_CALL_DEBUG=1
