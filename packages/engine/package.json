{
  "name": "@archsim/engine",
  "version": "0.0.1",
  "description": "Headless capacity simulation engine. No React, no DOM.",
  "type": "module",
  "main": "./src/index.ts",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikeya1621/archsim.git",
    "directory": "packages/engine"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx bin/sim.ts",
    "whatif": "tsx bin/whatif.ts",
    "check-inference": "tsx bin/check-inference.ts",
    "compare": "tsx bin/run-comparison.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "ajv": "^8.20.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
